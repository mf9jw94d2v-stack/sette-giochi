# Sette Giochi — environment template.
# Copy to `.env.local` and fill in. NEVER commit real values: `.env*` files
# other than this one are ignored by Git.
#
# Without the Supabase values the app runs as a guest-only build: results stay
# in the browser, and account pages say that accounts are not active.

# --- Supabase, browser side (safe to expose: protected by Row Level Security) ---
# Project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# The PUBLISHABLE key (sb_publishable_…) or, on older projects, the "anon" key.
# NEVER a secret key (sb_secret_…) or the service_role key: the app refuses
# to start the backend with one of those.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Older name, still accepted if the one above is empty.
# VITE_SUPABASE_ANON_KEY=

# "true" only after Google sign-in is configured in the Supabase dashboard.
VITE_AUTH_GOOGLE_ENABLED=

# --- App config ---
# Day boundary of the daily challenge. Must match private.challenge_day() in
# supabase/migrations (UTC): change both or neither.
VITE_DAILY_TIMEZONE=UTC

# --- Game Quality Lab (technical dashboard) ---
# Always available in `npm run dev`. In a production build the route exists
# only when this is "true". NOT authentication — see src/features/lab/access.ts.
VITE_ENABLE_QUALITY_LAB=

# --- Server side: Edge Function secrets live in Supabase, not here ---
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to the Edge
# Functions by Supabase itself. Optional, set with `supabase secrets set`:
#   ALLOWED_ORIGINS=https://your-site.example
